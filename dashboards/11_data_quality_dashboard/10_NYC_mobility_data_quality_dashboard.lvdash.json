{
  "datasets": [
    {
      "name": "a3a96883",
      "displayName": "data_quality_results",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-08`.`01-control`.data_quality_results",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "pass_rate",
            "expr": "100.0 * (SUM(`total_count`) - SUM(`fail_count`)) / NULLIF(SUM(`total_count`), 0)",
            "displayName": "Pass Rate",
            "comment": "Percentage of checks that passed — (total_count minus fail_count) divided by total_count times 100. Required because pass rate is a compound ratio that cannot be expressed directly in a widget expression."
          }
        ]
      }
    },
    {
      "name": "d1525da3",
      "displayName": "gate_status",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-08`.`01-control`.gate_status",
